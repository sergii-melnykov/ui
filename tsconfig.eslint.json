{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "./.cache/.tsbuildinfo-eslint",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "storybook-static",
    "build",
    "out",
    ".next",
    ".turbo",
    "coverage",
    "plugins",
    "scripts",
    ".agents",
    "docs",
    "tokens"
  ]
}
