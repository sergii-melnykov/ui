{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Token values are full CSS colors (oklch(...) preferred) or legacy HSL triplets (H S% L%) converted at sync time. radius uses rem.",
  "type": "object",
  "required": ["meta", "light", "dark"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["source", "fileKey", "collection"],
      "properties": {
        "source": { "const": "figma" },
        "fileKey": { "type": "string" },
        "fileName": { "type": "string" },
        "collection": { "type": "string" },
        "syncedAt": { "type": "string" }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "dark": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
