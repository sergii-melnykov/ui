{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "overridableVariables",
    "tailwindThemeBridge",
    "consumerPattern",
    "defaults"
  ],
  "properties": {
    "overridableVariables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cssVariable", "scopes"],
        "properties": {
          "name": { "type": "string" },
          "cssVariable": { "type": "string" },
          "scopes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tailwindThemeBridge": {
      "type": "array",
      "items": { "type": "string" }
    },
    "consumerPattern": { "type": "object" },
    "defaults": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": {
        "light": { "type": "object" },
        "dark": { "type": "object" }
      }
    }
  }
}
